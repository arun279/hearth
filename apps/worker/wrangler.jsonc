{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearth",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "workers_dev": true,
  "preview_urls": true,

  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    // SPA fallback — deep-link refreshes (e.g. /g/:groupId) serve index.html
    // instead of 404'ing. Valid values per CF docs: "single-page-application"
    // | "404-page" | "none".
    "not_found_handling": "single-page-application",
    // Opts the listed paths out of CF Static Assets' SPA-fallback
    // routing. With `not_found_handling: "single-page-application"`
    // and the navigation-prefers-asset-serving compat flag (implicit
    // at compat_date >= 2025-04-01), any browser request carrying
    // `Sec-Fetch-Mode: navigate` that doesn't match a static asset
    // gets `index.html` and the Worker is never invoked — silently
    // breaking OAuth callbacks, magic-link landings, and any other
    // API route reachable via top-level navigation. `run_worker_first`
    // is CF's documented escape hatch.
    "run_worker_first": ["/api/*", "/healthz"]
  },

  "vars": {
    "BETTER_AUTH_URL": "https://hearth.wiki",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://hearth.wiki,http://localhost:5173,http://localhost:8787"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hearth",
      "database_id": "e6843cc1-c185-468a-84bc-cd991b81a091",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "hearth-storage"
    }
  ],

  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "2",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "hearth_telemetry" }],

  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": { "enabled": true },

  "env": {
    "e2e": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hearth",
          "database_id": "11111111-1111-4111-8111-111111111111",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          // Same bucket_name as the default env: Miniflare keys local R2
          // state by binding name, not bucket name, so the e2e Worker
          // still gets a separate sqlite-backed bucket. Keeping the
          // name matches the presigner config in `apps/worker/src/
          // index.ts`, which hardcodes the bucket for S3-compat URL
          // signing.
          "bucket_name": "hearth-storage"
        }
      ],
      "ratelimits": [
        {
          "name": "WRITE_LIMITER",
          "namespace_id": "1",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "AUTH_LIMITER",
          "namespace_id": "2",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "hearth_e2e_telemetry" }],
      "vars": {}
    }
  }
}
